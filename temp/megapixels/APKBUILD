pkgname=megapixels
_pkgver=2.1.0
pkgver=9999$_pkgver
pkgrel=0
pkgdesc="GTK+4 camera app for mobile devices"
url="https://gitlab.com/megapixels-org/Megapixels"
arch="all !s390x"
license="GPL-3.0-only"
depends="libraw-tools imagemagick exiftool"
makedepends="
	feedbackd-dev
	glib-dev
	gperf
	gtk4.0-dev
	libdng-dev
	libmegapixels-dev
	libxrandr-dev
	meson
	pulseaudio-dev
	tiff-dev>=4.6.0t
	zbar-dev
	"
source="https://gitlab.com/megapixels-org/Megapixels/-/archive/$_pkgver/Megapixels-$_pkgver.tar.bz2
	0001-dcp-fix-calibration-profile-lookup.patch
	"
options="!check"
builddir="$srcdir/Megapixels-$_pkgver"

build() {
	abuild-meson . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

