# Reference: <https://postmarketos.org/devicepkg>
# ZTE Blade S6 (P839F30) - mainline MSM8939
pkgname=device-zte-p839f30
pkgdesc="ZTE Blade S6 (P839F30)"
pkgver=1
pkgrel=41
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
install="device-zte-p839f30.post-install"
depends="
	postmarketos-base
	postmarketos-mkinitfs-hook-debug-shell
	mkbootimg
	linux-postmarketos-qcom-msm8916
	soc-qcom-msm8939
	bluez
	bluez-openrc
	alsa-utils
	rmtfs
	iw
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	device-zte-p839f30.post-install
	50-zte-p839f30.gschema.override
"
subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
	$pkgname-console-autologin:console_autologin
	"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -m755 "$srcdir/device-zte-p839f30.post-install" "$pkgdir/device-zte-p839f30.post-install"
	install -Dm644 "$srcdir/50-zte-p839f30.gschema.override" \
		"$pkgdir/usr/share/glib-2.0/schemas/50-zte-p839f30.gschema.override"
}

nonfree_firmware() {
	pkgdesc="WiFi firmware (WCNSS NV + modem partition loader)"
	depends="
		msm-firmware-loader-wcnss
		firmware-zte-p839f30-wcnss-nv
		firmware-qcom-adreno-a420
	"
	mkdir -p "$subpkgdir"
}

console_autologin() {
	pkgdesc="Autologin on tty1 and the serial console"
	install="$subpkgname.post-install"
	depends="agetty"

	mkdir -p "$subpkgdir"
}

