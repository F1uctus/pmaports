# Reference: <https://postmarketos.org/deviceinfo>
# ZTE Blade S6 (P839F30) - mainline MSM8939
# Please use double quotes only. You can source this file in shell scripts.

deviceinfo_format_version="0"
deviceinfo_name="ZTE Blade S6"
deviceinfo_manufacturer="ZTE"
deviceinfo_codename="zte-p839f30"
deviceinfo_year="2015"
deviceinfo_dtb="qcom/msm8939-zte-blade-s6"
deviceinfo_append_dtb="true"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_external_storage="true"
deviceinfo_screen_width="720"
deviceinfo_screen_height="1280"
deviceinfo_getty="ttyMSM0;115200"

deviceinfo_no_framebuffer="false"

# Compressed swap (~50% of RAM) for 2 GiB devices
deviceinfo_zram_swap_pct="50"

# Bootloader related (lk2nd; we flash via adb)
deviceinfo_flash_method="fastboot"
# console=tty1 puts the boot log on the panel; consoleblank=0 stops the blank timer.
# The rootfs is found by the pmos_*_uuid that boot-deploy appends, so the same
# deviceinfo serves a rootfs on userdata or on the system partition.
deviceinfo_kernel_cmdline="earlycon=msm_serial_dm,0x78b0000 console=ttyMSM0,115200 console=tty1 loglevel=8 clk_ignore_unused pd_ignore_unused lk2nd.pass-ramoops lk2nd.pass-simplefb consoleblank=0"
deviceinfo_generate_bootimg="true"
deviceinfo_flash_offset_base="0x80000000"
deviceinfo_flash_offset_kernel="0x00080000"
deviceinfo_flash_offset_ramdisk="0x02000000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x01e00000"
deviceinfo_flash_pagesize="2048"
deviceinfo_flash_sparse="true"
