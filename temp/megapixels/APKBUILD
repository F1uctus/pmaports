pkgname=megapixels
_pkgver=2.1.0
pkgver=9999$_pkgver
pkgrel=2
pkgdesc="GTK+4 camera app for mobile devices"
url="https://gitlab.com/megapixels-org/Megapixels"
arch="all !s390x"
license="GPL-3.0-only"
depends="libraw-tools imagemagick exiftool"
makedepends="
	feedbackd-dev
	glib-dev
	gperf
	gtk4.0-dev
	libdng-dev
	libmegapixels-dev
	libxrandr-dev
	meson
	pulseaudio-dev
	tiff-dev>=4.6.0t
	zbar-dev
	"
source="https://gitlab.com/megapixels-org/Megapixels/-/archive/$_pkgver/Megapixels-$_pkgver.tar.bz2
	0001-dcp-fix-calibration-profile-lookup.patch
	0002-pipeline-reset-controls-when-changing-cameras.patch
	0003-preview-apply-display-gamma-to-raw-frames.patch
	0004-preview-apply-DCP-forward-matrices-in-color-order.patch
	0005-aaa-keep-DCP-matrices-out-of-white-balance.patch
	0006-preview-pick-the-forward-matrix-for-the-scene-illumi.patch
	0007-aaa-measure-white-balance-in-linear-sensor-space.patch
	0008-io-return-buffers-before-reconfiguring-the-stream.patch
	"
options="!check"
builddir="$srcdir/Megapixels-$_pkgver"

build() {
	abuild-meson . output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}

