 static void
-process_aaa()
+process_wb_statistics(uint32_t *pixels, float blacklevel, float averages[3])
+{
+        int width = output_buffer_width;
+        int height = output_buffer_height / 3;
+        size_t count = (size_t)width * height;
+        glReadPixels(0, height, width, height, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+        uint64_t sums[3] = { 0 };
+        size_t valid = 0;
+        float white = 250.0f - blacklevel * 255.0f;
+
+        for (size_t i = 0; i < count; i++) {
+                unsigned int r = pixels[i] & 0xff;
+                unsigned int g = (pixels[i] >> 8) & 0xff;
+                unsigned int b = (pixels[i] >> 16) & 0xff;
+                if (r < 2 || g < 2 || b < 2 ||
+                    r > white || g > white || b > white) {
+                        continue;
+                }
+                sums[0] += r;
+                sums[1] += g;
+                sums[2] += b;
+                valid++;
+        }
+        for (int i = 0; i < 3; i++) {
+                averages[i] = valid ? (float)sums[i] / valid : 0.0f;
+        }
+}
+
+static void
+process_aaa(uint32_t *center, const float *wb)
 {
