From 6e983c1b60386b7637862e811963af9860ad57b7 Mon Sep 17 00:00:00 2001
From: "Ilya I. Nikitin" <ilya.i.nikitin@proton.me>
Date: Sat, 12 Sep 2026 15:58:34 +0300
Subject: [PATCH] preview: apply DCP forward matrices in color order

The CPU composed white balance, ForwardMatrix, D50-to-D65 adaptation and sRGB conversion in reverse order, then uploaded the row-major result as column-major. Compose the camera-to-display transform in color-flow order, transpose it for GLES, and keep the no-profile fallback neutral. Reset calibration state when switching cameras so a previous tone curve cannot leak.

Signed-off-by: Ilya I. Nikitin <ilya.i.nikitin@proton.me>
---
 data/debayer.frag        |  2 +-
 data/debayer_packed.frag |  2 +-
 src/gles2_debayer.c      | 30 ++++++++++++++++--------------
 src/process_pipeline.c   | 14 ++++++++------
 4 files changed, 26 insertions(+), 22 deletions(-)

diff --git a/data/debayer.frag b/data/debayer.frag
index 081f076..ab0eb97 100644
--- a/data/debayer.frag
+++ b/data/debayer.frag
@@ -34,7 +34,7 @@ main()
     #endif
 
     color -= blacklevel;
-    color *= color_matrix;
+    color = color_matrix * color;
 
     vec3 gamma_color = pow(max(color, vec3(0.0)), vec3(inv_gamma));
     gl_FragColor = vec4(gamma_color, 1);
diff --git a/data/debayer_packed.frag b/data/debayer_packed.frag
index 6314b0c..b57ebf0 100644
--- a/data/debayer_packed.frag
+++ b/data/debayer_packed.frag
@@ -52,7 +52,7 @@ main()
     #endif
 
     color -= blacklevel;
-    color *= color_matrix;
+    color = color_matrix * color;
 
     vec3 gamma_color = pow(max(color, vec3(0.0)), vec3(inv_gamma));
     gl_FragColor = vec4(gamma_color, 1);
diff --git a/src/gles2_debayer.c b/src/gles2_debayer.c
index 1248b7e..afee48a 100644
--- a/src/gles2_debayer.c
+++ b/src/gles2_debayer.c
@@ -166,28 +166,30 @@ gles2_debayer_set_shading(GLES2Debayer *self,
                           float blue,
                           float blacklevel)
 {
+        float wb[9] = {
+                // clang-format off
+                red, 0,   0,
+                0,   1,   0,
+                0,   0, blue,
+                // clang-format on
+        };
         if (self->forward_matrix[0]) {
-                float wb[9] = {
-                        // clang-format off
-                        red, 0,   0,
-                        0,   1,   0,
-                        0,   0, blue,
-                        // clang-format on
-                };
-                float colormat[9];
-                float xyz[9];
+                float balanced[9];
                 float xyzd65[9];
-                multiply_matrices(wb, self->forward_matrix, xyz);
-                multiply_matrices(xyz, XYZD50_to_D65, xyzd65);
-                multiply_matrices(xyzd65, XYZD65_to_sRGB, colormat);
+                float srgb[9];
+                float upload[9];
+                multiply_matrices(self->forward_matrix, wb, balanced);
+                multiply_matrices(XYZD50_to_D65, balanced, xyzd65);
+                multiply_matrices(XYZD65_to_sRGB, xyzd65, srgb);
+                transpose_matrix(srgb, upload);
                 glUniformMatrix3fv(
-                        self->uniform_color_matrix, 1, GL_FALSE, colormat);
+                        self->uniform_color_matrix, 1, GL_FALSE, upload);
         } else if (self->shader == SHADER_YUV) {
                 glUniformMatrix3fv(
                         self->uniform_color_matrix, 1, GL_FALSE, YUV_to_RGB);
         } else {
                 glUniformMatrix3fv(
-                        self->uniform_color_matrix, 1, GL_FALSE, IDENTITY);
+                        self->uniform_color_matrix, 1, GL_FALSE, wb);
         }
         check_gl();
 
diff --git a/src/process_pipeline.c b/src/process_pipeline.c
index c58cdfd..1ce2e1e 100644
--- a/src/process_pipeline.c
+++ b/src/process_pipeline.c
@@ -1609,16 +1609,18 @@ update_state(MPPipeline *pipeline, const mp_state_proc *new_state)
         state_proc.flash_enabled = new_state->flash_enabled;
 
         if (camera_changed) {
+                free(state_proc.calibration.tone_curve);
+                memset(&state_proc.calibration, 0, sizeof(state_proc.calibration));
                 char cf[PATH_MAX];
                 if (find_calibration(sizeof(cf), cf, state_proc.camera->name)) {
                         state_proc.calibration = parse_calibration_file(cf);
                 } else {
-                        fprintf(stderr, "No calibration for %s\n", state_proc.camera->name);
-                        memcpy(state_proc.calibration.forward_matrix_1, sRGB_to_XYZD65, 9 * sizeof(float));
-                        // The below is the same as calling libmegapixels' libmegapixels_aaa_init, but as we call
-                        // libmegapixels_aaa_set_matrix, we need it to be in the calibration
-                        memcpy(state_proc.calibration.color_matrix_1, IDENTITY, 9 * sizeof(float));
-                        memcpy(state_proc.calibration.color_matrix_2, IDENTITY, 9 * sizeof(float));
+                        memcpy(state_proc.calibration.color_matrix_1,
+                               IDENTITY,
+                               9 * sizeof(float));
+                        memcpy(state_proc.calibration.color_matrix_2,
+                               IDENTITY,
+                               9 * sizeof(float));
                 }
         }
 
